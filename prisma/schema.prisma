generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  feedback  Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String
  passwordHash String
  role         Role     @default(VIEWER)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports      Report[] @relation("ReportGeneratedBy")

  @@unique([email, workspaceId])
  @@index([workspaceId])
}

model Feedback {
  id             String          @id @default(cuid())
  content        String
  channel        String
  sourceRef      String?
  customerLabel  String?
  sentiment      Sentiment       @default(NEU)
  sentimentScore Decimal?        @db.Decimal(4, 3)
  status         FeedbackStatus  @default(NEW)
  createdAt      DateTime        @default(now())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  themes         FeedbackTheme[]
  embedding      Embedding?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, channel])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, status])
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedback    FeedbackTheme[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Decimal  @db.Decimal(4, 3)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
  @@index([themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     Unsupported("vector")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Report {
  id            String   @id @default(cuid())
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  contentJson   Json
  createdAt     DateTime @default(now())
  workspaceId   String
  generatedById String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedBy   User      @relation("ReportGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
}
